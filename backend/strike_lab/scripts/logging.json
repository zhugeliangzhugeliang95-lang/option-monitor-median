{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"standard": {"format": "%(asctime)s %(levelname)s %(message)s"}},
  "handlers": {
    "file": {"class": "logging.handlers.RotatingFileHandler", "filename": "runtime/server.log",
             "maxBytes": 1048576, "backupCount": 1, "encoding": "utf-8", "formatter": "standard"}
  },
  "root": {"level": "WARNING", "handlers": ["file"]},
  "loggers": {"uvicorn": {"level": "INFO", "handlers": ["file"], "propagate": false}}
}
